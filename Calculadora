# Código de uma calculadora simples em Python

# num1, num2, op, resultado

num1 = 0
num2 = 0
resultado = 0
op = ''

while True:
    num1 = float(input('Digite o primeiro número: '))
    op = input('Digite a operação matemática a ser feita: ') 
    num2 = float(input('Digite o segundo número: '))

    if op == '+':
        resultado = num1 + num2
    elif op == '-':
        resultado = num1 - num2
    elif op == '*':
        resultado = num1 * num2
    elif op == '/':
        resultado = num1 / num2
    else:
        print('Operação inválida!')

    print('{} {} {} = {}'.format(num1, op, num2, resultado))
    